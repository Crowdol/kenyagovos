// Example: Issue a Digital ID Credential
const DID = require('did-jwt');
const { Resolver } = require('did-resolver');
const { getResolver } = require('ethr-did-resolver');

// Configure Ethereum resolver (for demo)
const providerConfig = { rpcUrl: 'https://mainnet.infura.io/v3/...' };
const resolver = new Resolver(getResolver(providerConfig));

// Citizen's DID (generated from a key pair)
const citizenDid = 'did:ethr:0x1234...';
const issuerDid = 'did:ethr:0xKenyaGov...';

// Create a verifiable credential
const vcPayload = {
  sub: citizenDid,
  nbf: Math.floor(Date.now() / 1000),
  vc: {
    '@context': ['https://www.w3.org/2018/credentials/v1'],
    type: ['VerifiableCredential', 'NationalIDCredential'],
    credentialSubject: {
      id: citizenDid,
      name: 'Jane Doe',
      idNumber: '12345678',
      nationality: 'Kenyan'
    }
  }
};

// Sign with issuer's private key
const issuerPrivateKey = '0x...';
const jwt = await DID.createJWT(vcPayload, { issuer: issuerDid, signer: DID.SimpleSigner(issuerPrivateKey) });
console.log('Verifiable Credential JWT:', jwt);
